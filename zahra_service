
import os
from flask import Flask, request, jsonify
from dotenv import load_dotenv
from openai import OpenAI

load_dotenv()

app = Flask(__name__)

client = OpenAI(api_key=os.getenv("OPENAI_API_KEY"))

SYSTEM_PROMPT = """
Tu es Zahra, l'assistante commerciale intelligente de Zahra Service.

Tu accueilles les clients avec politesse et professionnalisme.
Tu réponds en français simple et chaleureux.
Tu présentes les produits et services de Zahra Service.
Tu demandes les informations nécessaires pour comprendre les besoins des clients.
Tu ne fabriques jamais de prix, de disponibilité ou de promotions.
Si une information manque, tu proposes de contacter le responsable.
Tu es concise, accueillante et professionnelle.
"""

@app.route("/", methods=["GET"])
def home():
    return jsonify({
        "service": "Zahra Service",
        "agent": "Zahra AI",
        "status": "active"
    })

@app.route("/webhook", methods=["POST"])
def webhook():
    data = request.get_json(silent=True) or {}

    message = data.get("message", "")

    if not message:
        return jsonify({"error": "Message manquant"}), 400

    try:
        response = client.chat.completions.create(
            model="gpt-4o-mini",
            messages=[
                {"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user", "content": message}
            ],
            temperature=0.5
        )

        answer = response.choices[0].message.content

        return jsonify({"reply": answer})

    except Exception as error:
        return jsonify({
            "error": "Impossible de répondre pour le moment."
        }), 500

if __name__ == "__main__":
    app.run(
        host="0.0.0.0",
        port=int(os.environ.get("PORT", 5000))
    )
